# ==============================
# Agents local runtime
# ==============================

# Repository identity
AGENTS_REPO=hoonoh57/agents
AGENTS_BRANCH=main
AGENTS_LOCAL_ROOT=E:\2026\gpt\agents

# Research system source/reference
RESEARCH_REPO=hoonoh57/kiwoom-autotrade-template
RESEARCH_LOCAL_ROOT=E:\2026\opus\typescript\kiwoom-autotrade-template

# Local runtime storage (NOT committed)
AGENT_RUNTIME_DIR=E:\2026\gpt\agents\runtime
AGENT_LOG_DIR=E:\2026\gpt\agents\logs
AGENT_CACHE_DIR=E:\2026\gpt\agents\cache
AGENT_RESEARCH_DATA_DIR=E:\2026\gpt\agents\research-data
AGENT_ARTIFACT_DIR=E:\2026\gpt\agents\research-artifacts
AGENT_VECTOR_INDEX_DIR=E:\2026\gpt\agents\vector-index
AGENT_MODEL_CACHE_DIR=E:\2026\gpt\agents\model-cache
AGENT_LEASE_DB=E:\2026\gpt\agents\runtime\agent_leases.sqlite3

# Local model gateway
# Concrete models are benchmark-selected later; do not hard-code architecture to one model.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_FAST_MODEL=
LOCAL_LLM_REASONER_MODEL=
LOCAL_LLM_CODER_MODEL=

# Runtime scheduling
AGENT_WORKER_ID=local-01
AGENT_MAX_CONCURRENT_TASKS=1
AGENT_POLL_SECONDS=10
AGENT_LEASE_SECONDS=900
AGENT_HEARTBEAT_SECONDS=30

# Safety / execution
AGENT_AUTOPUSH=true
AGENT_ALLOW_EXTERNAL_ESCALATION=true
AGENT_ALLOW_GENERATED_CODE_EXECUTION=false
AGENT_ALLOW_BROKER_ACTIONS=false

# Optional external frontier LLM integration.
# Keep secrets only in .env; never commit them.
EXTERNAL_LLM_PROVIDER=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_API_KEY=
